Platform : LeetCode
Problem  : 9. Palindrome Number
Difficulty : Easy

Approach:
- Reverse only half of the number.
- Compare the first half with the reversed second half.

Time Complexity: O(log n)

Space Complexity: O(1)

class Solution {
public:
    bool isPalindrome(int x) {
        if(x<0 || (x % 10 == 0 && x != 0)){
            return false;
        }
        long long rev = 0;
        while(x > rev){
            int digit = x %  10;
            rev = 10 * rev + digit;
            x /= 10;
        }
        return (x == rev)||(x == rev/10);
    }
};
